# Copiar a backend/.env y completar. El .env no se sube al repositorio.

# Modo de desarrollo: 1 muestra errores detallados; en producción debe ser 0.
ARRIBO_DEBUG=1

# Clave con la que Django firma sesiones y tokens. Larga, aleatoria y distinta en cada entorno.
# Obligatoria cuando ARRIBO_DEBUG=0.
ARRIBO_SECRET_KEY=cambiar-por-una-cadena-larga-y-aleatoria

# Dominios desde los que se atiende el panel, separados por coma. Vacío en desarrollo.
# Ejemplo en producción: arribo.ejemplo.com
ARRIBO_ALLOWED_HOSTS=

# Conexión a PostgreSQL: postgres://USUARIO:CLAVE@SERVIDOR:PUERTO/BASE
# Si la contraseña tiene símbolos (@ : / # ? %), hay que codificarlos (por ejemplo @ es %40).
# Las pruebas crean y borran su propia base "test_arribo": el usuario necesita permiso CREATEDB.
DATABASE_URL=postgres://arribo:CLAVE@localhost:5432/arribo
