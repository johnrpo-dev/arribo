# Copiar a .env (no se sube al repositorio).

# 1 en desarrollo, 0 en producción.
ARRIBO_DEBUG=1

# Obligatoria en producción. Generar una cadena larga y aleatoria.
ARRIBO_SECRET_KEY=

# Dominios separados por coma. Vacío en desarrollo.
ARRIBO_ALLOWED_HOSTS=

# PostgreSQL. Si se deja vacía, el esqueleto arranca con SQLite (solo para verificar que corre).
# DATABASE_URL=postgres://arribo:CLAVE@localhost:5432/arribo
