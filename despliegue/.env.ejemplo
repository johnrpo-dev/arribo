# Copiar a despliegue/.env en el servidor y completar. El .env no se sube al repositorio.

# Dominio del panel, sin https:// (por ejemplo arribo.suempresa.co). Debe apuntar a la IP del VPS
# (registro A en el proveedor del dominio) antes de desplegar: Caddy saca el certificado con él.
ARRIBO_DOMINIO=

# Clave larga y aleatoria. Generarla en el servidor con:
#   openssl rand -base64 48
ARRIBO_SECRET_KEY=

# Contraseña de la base de datos, solo letras y dígitos (va dentro de una URL). Generarla con:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Carpeta del servidor donde está la cuenta de servicio de Firebase (fuera del repositorio).
ARRIBO_SECRETOS=/opt/arribo/secretos
# Ruta del JSON vista desde dentro del servidor de Arribo (la carpeta de arriba queda en
# /run/secretos). Vacío = no se envían avisos push.
# Ejemplo: /run/secretos/cuenta-de-servicio.json
ARRIBO_FIREBASE_CREDENCIALES=

# Carpeta del servidor donde quedan los respaldos diarios de la base (se guardan 14).
ARRIBO_RESPALDOS=/opt/arribo/respaldos
